server:
  port: ${SERVER_PORT:8081}

spring:
  application:
    name: comisariato-java-api
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/comisariato_taller}
    username: ${DB_USER:postgres}
    password: ${DB_PASSWORD:}
  mvc:
    problemdetails:
      enabled: true

management:
  endpoints:
    web:
      exposure:
        include: health

springdoc:
  paths-to-match: /api/**
  swagger-ui:
    path: /swagger-ui.html
